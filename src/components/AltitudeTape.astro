---
import type { TapeSection } from '../data/content';

interface Props {
  sections: TapeSection[];
}

const { sections } = Astro.props;
---
<nav class="tape" aria-label="Section position">
  <div class="tape-readout">
    <span class="tape-readout-label" id="tapeLabel">{sections[0].label}</span>
    <span class="tape-readout-alt" id="tapeAlt">FL400</span>
  </div>
  <div class="tape-line">
    <div class="tape-marker" id="tapeMarker" aria-hidden="true"></div>
    {sections.map((s) => (
      <a href={`#${s.id}`} class="tape-tick" data-id={s.id} aria-label={s.label}>
        <span class="tape-tick-alt"></span>
        <span class="tape-tick-line"></span>
      </a>
    ))}
  </div>
</nav>
