---
import type { TapeSection } from '../data/content';

interface Props {
  sections: TapeSection[];
}

const { sections } = Astro.props;
// skip hero + contact, add contact back at end
const visible = sections.filter((s) => s.id !== 'hero-viewport' && s.id !== 'contact');
const withContact = [...visible, ...sections.filter((s) => s.id === 'contact')];
---
<nav class="bottom-tape" aria-label="Section position">
  <div class="bottom-tape-track">
    {withContact.map((s) => (
      <a href={`#${s.id}`} class="bottom-tape-tick" data-id={s.id}>
        <span class="bottom-tape-tick-label">{s.label}</span>
        <span class="bottom-tape-tick-mark"></span>
      </a>
    ))}
  </div>
</nav>
