---
import { Image } from 'astro:assets';
import airshow from '../assets/airshow.jpg';
---
<!-- Sectioned (list) view only - grid view has the Crew ID and Radio Check
     tiles doing this job inside the manifest instead. -->
<section
  id="sec-contact"
  data-tape-section
  data-tape-label="Contact"
  class="contact-section page-x bg-panel"
>
  <div class="max-w-7xl mx-auto w-full">
    <div class="tick-rule" aria-hidden="true"></div>
    <div class="contact-grid">
      <div class="contact-heading">
        <h2>Radio Check</h2>
      </div>
      <p class="contact-desc">Trying to find my way into the coolest industry on earth. Come in to talk aviation,
        <a href="https://beverleyy.notion.site/Keyboard-Collection-30c75a1e8b8e810da7f6c9b19b8c99d5" target="_blank" rel="noopener" class="contact-link-inline">mechanical keyboards</a>,
	or ask me about the <a href="/hub-run" target="_blank" rel="noopener" class="contact-link-inline">United 7&#8209;Hub Run</a> I'm attempting in 2027.</p>
      <div class="contact-buttons">
        <a href="mailto:yeokwb@stanford.edu" class="contact-btn">Email</a>
        <a href="https://www.linkedin.com/in/beverleyy" target="_blank" rel="noopener" class="contact-btn">LinkedIn</a>
      </div>
      <div class="id-badge">
        <span class="id-badge-tab" aria-hidden="true"></span>
        <span class="id-badge-label">Crew ID</span>
        <div class="id-badge-photo">
          <div class="id-badge-photo-frame">
            <svg viewBox="0 0 100 100" preserveAspectRatio="xMidYMax slice" aria-hidden="true" class="id-badge-silhouette">
              <circle cx="50" cy="32" r="16" fill="#0b1220" />
              <path d="M16 100 C 16 64 30 50 50 50 C 70 50 84 64 84 100 Z" fill="#0b1220" />
            </svg>
            <Image src={airshow} alt="Kai Wen Beverley Yeo" widths={[120, 240, 360]} sizes="7.3rem" loading="lazy" decoding="async" />
          </div>
        </div>
        <div class="id-badge-rows">
          <span class="id-badge-name">Yeo</span>
          <span class="id-badge-given">Kai Wen Beverley</span>
          <span class="id-badge-base">Base: SIN</span>
        </div>
        <span class="id-badge-foot" aria-hidden="true"></span>
      </div>
    </div>
  </div>
</section>
