---
import CrewBadge from './CrewBadge.astro';
---
<section id="contact" data-tape-section data-tape-label="Contact" style="background-color:var(--panel-bg);" class="py-14 px-6 transition-colors">
  <div class="max-w-7xl mx-auto space-y-8">
    <div class="tick-rule"></div>
    <div class="contact-grid">
      <div class="border-l-2 border-delta-red pl-4 [grid-area:heading] self-start" >
        <h2 class="text-3xl font-bold text-delta-navy dark:text-white uppercase tracking-wider">Radio Check</h2>
      </div>

      <p class="text-sm text-slate-500 max-w-2xl [grid-area:desc]">
        Trying to find my way into the coolest industry on earth. Come in to talk aviation, <a href="https://beverleyy.notion.site/Keyboard-Collection-30c75a1e8b8e810da7f6c9b19b8c99d5" target="_blank" rel="noopener" class="underline hover:text-delta-navy dark:hover:text-delta-sky transition">mechanical keyboards</a>, or ask me about the <a href="https://ua7hub.run" target="_blank" rel="noopener" class="underline hover:text-delta-navy dark:hover:text-delta-sky transition">United 7-Hub Run</a> I'm attempting in 2027.
      </p>

      <div class="flex flex-wrap gap-3 text-xs font-bold uppercase tracking-widest [grid-area:buttons] self-start">
        <a href="mailto:yeokwb@stanford.edu" class="px-5 h-11 inline-flex items-center border-2 border-slate-300 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:border-delta-navy hover:text-delta-navy dark:hover:border-delta-sky dark:hover:text-delta-sky transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-delta-red">Email</a>
        <a href="https://www.linkedin.com/in/beverleyy" target="_blank" rel="noopener" class="px-5 h-11 inline-flex items-center border-2 border-slate-300 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:border-delta-navy hover:text-delta-navy dark:hover:border-delta-sky dark:hover:text-delta-sky transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-delta-red">LinkedIn</a>
      </div>

      <CrewBadge />
    </div>
  </div>
</section>
