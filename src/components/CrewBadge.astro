---
---
<div class="relative flex flex-col overflow-hidden w-full self-start sm:w-auto sm:h-full sm:self-stretch bg-white dark:bg-slate-950 border-2 border-slate-300 dark:border-slate-800 [grid-area:badge]">
  <span class="absolute top-[3px] left-1/2 -translate-x-1/2 w-3.5 h-1 rounded-sm bg-slate-300 dark:bg-slate-700 z-[3]"></span>
  <span class="absolute top-[11px] left-2 text-[0.5rem] tracking-[0.08em] uppercase text-slate-400 dark:text-slate-500 z-[3]">CREW ID</span>

  <div class="flex items-center justify-center [flex:1_1_72%] p-[0.4rem] pt-[1.85rem] min-h-0">
    <div class="relative w-full h-auto max-w-full max-h-full aspect-square overflow-hidden border-2 border-slate-400 dark:border-slate-700 bg-gradient-to-b from-sky-200 via-sky-500 to-blue-950 dark:from-blue-800 dark:via-blue-950 dark:to-slate-950">
      <!-- silhouette sits underneath as the fallback if the photo is missing -->
      <svg viewBox="0 0 100 100" preserveAspectRatio="xMidYMax slice" aria-hidden="true" class="absolute inset-0 w-full h-full">
        <circle cx="50" cy="32" r="16" fill="#0b1220" opacity="0.85" />
        <path d="M16 100 C 16 64 30 50 50 50 C 70 50 84 64 84 100 Z" fill="#0b1220" opacity="0.85" />
      </svg>
      <img
        src="airshow.jpg"
        alt="Kai Wen Beverley Yeo"
        loading="lazy"
        decoding="async"
        onerror="this.style.display='none'"
        class="absolute inset-0 w-full h-full object-cover object-center"
      />
    </div>
  </div>

  <div class="flex flex-col justify-center gap-[0.15rem] px-[0.4rem] pt-[0.35rem] pb-[0.4rem] min-h-0 border-t border-slate-300 dark:border-slate-800 [flex:1_1_auto]">
    <span class="uppercase whitespace-nowrap text-[0.62rem] font-bold tracking-[0.04em] text-slate-900 dark:text-slate-100">Yeo</span>
    <span class="uppercase whitespace-nowrap text-[0.62rem] tracking-[0.01em] text-slate-400 dark:text-slate-500">Kai Wen Beverley</span>
    <span class="uppercase text-[0.42rem] tracking-[0.04em] text-delta-red mt-[0.2rem]">BASE: SIN</span>
  </div>

  <span class="h-1 flex-shrink-0 bg-delta-red"></span>
</div>