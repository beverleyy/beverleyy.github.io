---
import type { EducationEntry } from '../data/content';

interface Props {
  education: EducationEntry[];
}

const { education } = Astro.props;
---
<section id="education" data-tape-section data-tape-label="Education" style="background-color:var(--panel-bg);" class="py-14 px-6 transition-colors">
  <div class="max-w-7xl mx-auto space-y-8">
    <div class="tick-rule"></div>
    <div class="border-l-2 border-delta-red pl-4">
      <h2 class="text-3xl font-bold text-delta-navy dark:text-white uppercase tracking-wider">Education</h2>
    </div>

    <div class="space-y-3">
      {education.map((entry, index) => (
        <details class="boarding-pass">
          <summary class="boarding-pass-summary">
            <span class="boarding-pass-stub">
              <span class="boarding-pass-stub-seq">{String(index + 1).padStart(2, '0')}/{String(education.length).padStart(2, '0')}</span>
              <span class="boarding-pass-chevron" aria-hidden="true">&#9662;</span>
            </span>
            <span class="boarding-pass-head">
              <span class="boarding-pass-field-label">{entry.years}</span>
              <h3 class="boarding-pass-title">{entry.programme}</h3>
              <span class="boarding-pass-inst" set:html={entry.institution} />
            </span>
          </summary>
          <dl class="boarding-pass-meta">
            {entry.meta.map((row) => (
              <>
                <dt>{row.label}</dt>
                <dd>{row.value}</dd>
              </>
            ))}
          </dl>
        </details>
      ))}
    </div>
  </div>
</section>
