---
import type { ExperienceEntry } from '../data/content';

interface Props {
  experience: ExperienceEntry[];
}

const { experience } = Astro.props;

const statusBadge: Record<ExperienceEntry['status'], string> = {
  current: 'px-2 py-0.5 border border-emerald-600 text-emerald-600 dark:text-emerald-400 font-bold text-[10px]',
  past: 'px-2 py-0.5 border border-amber-600 text-amber-600 dark:text-amber-400 font-bold text-[10px]',
};
const statusLabel: Record<ExperienceEntry['status'], string> = { current: 'CURRENT', past: 'PAST' };
---
<section id="experience" data-tape-section data-tape-label="Experience" style="background-color:var(--panel-bg);" class="py-14 px-6 transition-colors">
  <div class="max-w-7xl mx-auto space-y-8">
    <div class="tick-rule"></div>
    <div class="border-l-2 border-delta-red pl-4">
      <h2 class="text-3xl font-bold text-delta-navy dark:text-white uppercase tracking-wider">Experience</h2>
    </div>

    <div class="w-full overflow-x-auto border-2 border-slate-300 dark:border-slate-800">
      <table class="w-full text-left border-collapse text-sm bg-white dark:bg-slate-950">
        <thead>
          <tr class="bg-slate-50 dark:bg-slate-900 border-b-2 border-slate-300 dark:border-slate-800 text-slate-500 dark:text-slate-400 uppercase tracking-wider font-bold">
            <th class="p-4">Dates</th>
            <th class="p-4">Company</th>
            <th class="p-4">Role</th>
            <th class="p-4">Department</th>
            <th class="p-4 text-right">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-300 dark:divide-slate-800 text-slate-700 dark:text-slate-300">
          {experience.map((job) => (
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-900/30 transition">
              <td class="p-4 font-bold">{job.dates}</td>
              <td class="p-4 job-title text-delta-navy dark:text-delta-sky font-bold">{job.company}</td>
              <td class="p-4">{job.role}</td>
              <td class="p-4">{job.department}</td>
              <td class="p-4 text-right"><span class={statusBadge[job.status]}>{statusLabel[job.status]}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
