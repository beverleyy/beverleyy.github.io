---
/* neutral airfoil mark, not from any airline's logo */
interface Props {
  name: 'mark';
  class?: string;
}

const { name, class: className = '' } = Astro.props;
---
{name === 'mark' && (
  <svg class={className} viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round">
    <path d="M4 22 C 12 20, 22 16, 28 8 C 22 12, 12 16, 4 18 Z" fill="currentColor" stroke="none" />
    <line x1="4" y1="24" x2="26" y2="24" stroke="currentColor" stroke-width="1.5" opacity="0.5" />
  </svg>
)}
