---
import type { ProjectEntry } from '../data/content';

interface Props {
  projects: ProjectEntry[];
}

const { projects } = Astro.props;

const statusLabel: Record<ProjectEntry['status'], string> = {
  current: 'Current',
  ongoing: 'Ongoing',
  landed: 'Landed',
};

const eduLabel: Record<ProjectEntry['edu'], string> = {
  phd: 'PhD',
  meng: 'M.Eng',
  beng: 'B.Eng',
  pro: 'Industry',
};
const eduOrder: ProjectEntry['edu'][] = ['phd', 'meng', 'beng', 'pro'];

const typeLabel: Record<string, string> = {
  code: 'Code',
  math: 'Math',
  flows: 'Flows',
  builds: 'Builds',
  other: 'Others',
};
const typeOrder = ['code', 'math', 'flows', 'builds', 'other'];
---
<section id="research" data-tape-section data-tape-label="Research" style="background-color:var(--panel-bg);" class="py-14 px-6 transition-colors">
  <div class="max-w-7xl mx-auto space-y-8">
    <div class="tick-rule"></div>
    <div class="border-l-2 border-delta-red pl-4">
      <h2 class="text-3xl font-bold text-delta-navy dark:text-white uppercase tracking-wider">Research Projects</h2>
    </div>

    <div class="filter-bar" role="group" aria-label="Filter projects">
      <div class="filter-groups">
        <div class="filter-group" data-filter-group="category">
          <span class="filter-group-label">Category</span>
          <button type="button" class="filter-btn is-active" data-filter-value="*"><span class="filter-btn-led"></span>All</button>
          <button type="button" class="filter-btn" data-filter-value="research"><span class="filter-btn-led"></span>Research</button>
          <button type="button" class="filter-btn" data-filter-value="engineering"><span class="filter-btn-led"></span>Engineering</button>
        </div>
        <div class="filter-group" data-filter-group="edu">
          <span class="filter-group-label">Level</span>
          <button type="button" class="filter-btn is-active" data-filter-value="*"><span class="filter-btn-led"></span>All</button>
          {eduOrder.map((key) => (
            <button type="button" class="filter-btn" data-filter-value={key}><span class="filter-btn-led"></span>{eduLabel[key]}</button>
          ))}
        </div>
        <div class="filter-group" data-filter-group="type">
          <span class="filter-group-label">Type</span>
          <button type="button" class="filter-btn is-active" data-filter-value="*"><span class="filter-btn-led"></span>All</button>
          {typeOrder.map((key) => (
            <button type="button" class="filter-btn" data-filter-value={key}><span class="filter-btn-led"></span>{typeLabel[key]}</button>
          ))}
        </div>
      </div>
      <button type="button" class="filter-btn filter-toggle" id="activeToggle" aria-pressed="false">
        <span class="filter-btn-led"></span>Active only
      </button>
    </div>

    <ul class="strip-rack">
      {projects.map((item) => (
        <li class="strip" data-category={item.category} data-edu={item.edu} data-types={item.types.join(',')} data-status={item.status}>
          <div class="strip-row">
            <div class="strip-cell strip-cell--id">
              <span class="strip-callsign">{item.callsign}</span>
              <span class={`strip-status strip-status--${item.status}`}>{statusLabel[item.status]}</span>
            </div>
            <div class="strip-cell strip-cell--squawk">
              <span class="strip-cell-label">SQK</span>
              <span class="strip-squawk-value">{item.squawk}</span>
            </div>
            <div class="strip-cell strip-cell--route">
              <h3>{item.title}</h3>
              <p class="strip-blurb">{item.blurb}</p>
              {item.supervisors && item.supervisors.length > 0 && (
                <p class="strip-supervisors">Supervised by {item.supervisors.join(', ')}</p>
              )}
              {item.team && item.team.length > 0 && (
                <p class="strip-supervisors">Team: {item.team.join(', ')}</p>
              )}
            </div>
            {item.image && (
              <div class="strip-cell strip-cell--thumb">
                <span class="strip-thumb-fallback">ADD<br />PHOTO</span>
                <img src={item.image} alt="" loading="lazy" onerror="this.style.display='none'" />
              </div>
            )}
          </div>
          <div class="strip-remarks">
            {item.tools.map((tool) => <span class="strip-tool">{tool}</span>)}
            {item.links.map((link) => (
              <a href={link.href} class="strip-link">{link.label}</a>
            ))}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
