---
import type { ProjectEntry } from '../data/content';

interface Props {
  projects: ProjectEntry[];
}

const { projects } = Astro.props;

const statusLabel: Record<ProjectEntry['status'], string> = {
  current: 'Current',
  ongoing: 'Ongoing',
  landed: 'Landed',
};
---
<section id="research" data-tape-section data-tape-label="Projects" style="background-color:var(--panel-bg);" class="py-14 px-6 transition-colors">
  <div class="max-w-7xl mx-auto space-y-8">
    <div class="tick-rule"></div>
    <div class="border-l-2 border-delta-red pl-4">
      <h2 class="text-3xl font-bold text-delta-navy dark:text-white uppercase tracking-wider">Projects</h2>
    </div>

    <div class="filter-bar" role="group" aria-label="Filter projects">
      <div class="filter-groups">
        <div class="filter-group" data-filter-group="scope">
          <span class="filter-group-label">Show</span>
          <button type="button" class="filter-btn is-active" data-filter-value="featured"><span class="filter-btn-led"></span>Featured</button>
          <button type="button" class="filter-btn" data-filter-value="*"><span class="filter-btn-led"></span>Show all</button>
        </div>
      </div>
      <button type="button" class="filter-btn filter-toggle" id="activeToggle" aria-pressed="false">
        <span class="filter-btn-led"></span>Active only
      </button>
    </div>

    <ul class="strip-rack">
      {projects.map((item) => (
        <li class="strip" data-status={item.status} data-featured={item.featured ? 'true' : 'false'}>
          <div class="strip-row">
            <div class="strip-cell strip-cell--id">
              <span class="strip-callsign">{item.callsign}</span>
              <span class={`strip-status strip-status--${item.status}`}>{statusLabel[item.status]}</span>
            </div>
            <div class="strip-cell strip-cell--squawk">
              <span class="strip-cell-label">SQK</span>
              <span class="strip-squawk-value">{item.squawk}</span>
            </div>
            <div class="strip-cell strip-cell--route">
              <h3>{item.title}</h3>
              <p class="strip-blurb">{item.blurb}</p>
              {item.supervisors && item.supervisors.length > 0 && (
                <p class="strip-supervisors">Supervised by {item.supervisors.join(', ')}</p>
              )}
              {item.team && item.team.length > 0 && (
                <p class="strip-supervisors">Team: {item.team.join(', ')}</p>
              )}
            </div>
            {item.image && (
              <div class="strip-cell strip-cell--thumb">
                <span class="strip-thumb-fallback">ADD<br />PHOTO</span>
                <img src={item.image} alt="" loading="lazy" onerror="this.style.display='none'" />
              </div>
            )}
          </div>
          <div class="strip-remarks">
            {item.tools.map((tool) => <span class="strip-tool">{tool}</span>)}
            {item.links.map((link) => (
              <a href={link.href} class="strip-link">{link.label}</a>
            ))}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
