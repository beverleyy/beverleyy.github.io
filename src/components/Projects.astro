---
import { Image, getImage } from 'astro:assets';
import type { ProjectEntry } from '../data/content';

interface Props {
  projects: ProjectEntry[];
}

const { projects } = Astro.props;

/* Poster frames need a plain URL for the video's poster attribute, so they're
   resolved here rather than in the template - getImage is async and the strips
   are rendered inside a .map(). */
const posters = new Map<string, string>();
for (const item of projects) {
  if (item.video) {
    posters.set(item.title, (await getImage({ src: item.video.poster, format: 'webp', width: 384 })).src);
  }
}

const statusLabel: Record<ProjectEntry['status'], string> = {
  current: 'Current',
  ongoing: 'Ongoing',
  landed: 'Landed',
};

/* shared cell chrome; the semantic strip-* class names are kept as hooks for
   the mono-font rule in main.css and the per-airline overrides in airlines.css */
const cell = 'strip-cell flex flex-col justify-center gap-1 px-4 py-[0.8rem] border-r border-slate-300 dark:border-slate-800';
const microLabel = 'text-[0.58rem] uppercase tracking-[0.08em]';
---
<section id="research" data-tape-section data-tape-label="Projects" style="background-color:var(--panel-bg);" class="py-14 px-6 transition-colors">
  <div class="max-w-7xl mx-auto space-y-8">
    <div class="tick-rule"></div>
    <div class="border-l-2 border-delta-red pl-4">
      <h2 class="text-3xl font-bold text-delta-navy dark:text-white uppercase tracking-wider">Projects</h2>
    </div>

    <div
      class="filter-bar flex flex-wrap items-center justify-start gap-4 px-[1.1rem] py-[0.9rem] mb-6 border-2 border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-950 static xl:sticky xl:top-[var(--header-h,4rem)] z-[15]"
      role="group"
      aria-label="Filter projects"
    >
      <div class="flex flex-wrap items-center gap-4">
        <div class="flex flex-wrap items-center gap-1.5 w-full sm:w-auto" data-filter-group="scope">
          <span class="filter-group-label text-[0.62rem] uppercase tracking-[0.08em] text-delta-red mr-0.5">Show</span>
          <button type="button" class="filter-btn is-active" data-filter-value="featured" aria-pressed="true"><span class="filter-btn-led"></span>Featured</button>
          <button type="button" class="filter-btn" data-filter-value="*" aria-pressed="false"><span class="filter-btn-led"></span>All</button>
        </div>
      </div>
      <button type="button" class="filter-btn filter-toggle" id="activeToggle" aria-pressed="false">
        <span class="filter-btn-led"></span>Active only
      </button>
    </div>

    <ul class="list-none m-0 p-0 flex flex-col gap-3">
      {projects.map((item) => (
        <li
          class="strip bg-white dark:bg-slate-950"
          data-status={item.status}
          data-featured={item.featured ? 'true' : 'false'}
        >
          <div class="strip-row flex items-stretch flex-wrap">
            <div class={`${cell} strip-cell--id`}>
              {item.callsign && (
                <span class="strip-callsign text-[0.85rem] font-bold tracking-[0.04em] text-slate-900 dark:text-slate-100">{item.callsign}</span>
              )}
              <span class={`strip-status strip-status--${item.status} ${microLabel}`}>{statusLabel[item.status]}</span>
            </div>

            <div class={`${cell} strip-cell--squawk`}>
              <span class={`strip-cell-label ${microLabel} text-delta-red`}>SQK</span>
              <span class="strip-squawk-value text-[0.95rem] font-bold text-slate-900 dark:text-slate-100">{item.squawk}</span>
            </div>

            <div class={`${cell} strip-cell--route gap-[0.35rem]`}>
              <h3 class="m-0 text-[0.95rem] font-bold uppercase tracking-[0.02em] text-slate-900 dark:text-slate-100">{item.title}</h3>
              <p class="m-0 text-[0.8rem] leading-[1.5] text-slate-900 dark:text-slate-100">{item.blurb}</p>
              {item.supervisors && item.supervisors.length > 0 && (
                <p class="m-0 text-[0.72rem] text-slate-500 dark:text-slate-500">Supervised by {item.supervisors.join(', ')}</p>
              )}
              {item.team && item.team.length > 0 && (
                <p class="m-0 text-[0.72rem] text-slate-500 dark:text-slate-500">Team: {item.team.join(', ')}</p>
              )}
            </div>

            {(item.image || item.video) && (
              <div class="strip-cell strip-cell--thumb relative overflow-hidden bg-slate-300 dark:bg-slate-800">
                {item.video ? (
                  <video
                    class="strip-media"
                    autoplay
                    loop
                    muted
                    playsinline
                    preload="metadata"
                    poster={posters.get(item.title)}
                    role="img"
                    aria-label={item.alt}
                  >
                    <source src={item.video.webm} type="video/webm" />
                    <source src={item.video.mp4} type="video/mp4" />
                  </video>
                ) : (
                  <Image
                    src={item.image!}
                    alt={item.alt ?? ''}
                    widths={[128, 256, 384]}
                    sizes="(max-width: 720px) 5.5rem, 8rem"
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </div>
            )}
          </div>

          <div class="flex flex-wrap items-center gap-2 px-4 py-[0.65rem] border-t border-slate-300 dark:border-slate-800">
            {item.tools.map((tool) => (
              <span class="strip-tool text-[0.62rem] uppercase tracking-[0.04em] px-2 py-[0.2rem] border border-slate-300 dark:border-slate-800 text-slate-500 dark:text-slate-500">{tool}</span>
            ))}
            {item.links.map((link) => (
              <a
                href={link.href}
                class="strip-link inline-flex items-center gap-1.5 text-[0.62rem] font-bold uppercase tracking-[0.04em] px-[0.55rem] py-[0.2rem] border border-delta-red text-delta-red no-underline transition-colors"
              >{link.label}</a>
            ))}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>