---
import '../styles/main.css';
import 'lenis/dist/lenis.css';
import '../styles/header.css';
import '../styles/tape.css';
import '../styles/bottom-tape.css';
import '../styles/hero.css';
import '../styles/work-grid.css';
import '../styles/list-view.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Kai Wen Beverley Yeo - mechanical engineering PhD candidate at Stanford, headed for the aviation industry. Education, experience and projects.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/ailerons.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/b612-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/b612-mono-400.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <script is:inline>
      /* Resolve the panel state before first paint so there's no flash. Reads the saved choice, else SIA + dark. The derivation has to match airlineFor() in site.ts, which picks the state up from these data attributes rather than assuming a default. */
      (function () {
        var root = document.documentElement;
        var lights = false;
        var gain = false;
        try {
          var saved = localStorage.getItem('panel-state');
          if (saved) {
            var s = JSON.parse(saved);
            lights = !!s.lights;
            gain = !!s.gain;
          } else if (window.matchMedia('(prefers-color-scheme: light)').matches) {
            lights = true;
            gain = true;
          }
        } catch (e) {
          /* private mode or blocked storage; defaults are fine */
        }
        root.setAttribute('data-airline', lights ? (gain ? 'united' : 'american') : (gain ? 'delta' : 'sia'));
        root.classList.toggle('dark', !lights);
        root.dataset.panelLights = lights ? 'on' : 'off';
        root.dataset.panelGain = gain ? 'on' : 'off';

        var view = 'sectioned';
        try {
          /* key is versioned: the default flipped from grid to sectioned, and a
             stale saved value would otherwise keep overriding it */
          var savedView = localStorage.getItem('view-state-v2');
          if (savedView === 'sectioned' || savedView === 'grid') view = savedView;
        } catch (e) {}
        root.setAttribute('data-view', view);
      })();
    </script>
  </head>
  <body>
    <a href="#hero-viewport" class="skip-link">Skip to content</a>
    <div class="hud-corner tl"></div>
    <div class="hud-corner tr"></div>
    <div class="hud-corner bl"></div>
    <div class="hud-corner br"></div>
    <slot />
  </body>
</html>
